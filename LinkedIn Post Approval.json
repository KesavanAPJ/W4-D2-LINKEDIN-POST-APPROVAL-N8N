{
  "name": "LinkedIn Post Approval",
  "nodes": [
    {
      "parameters": {
        "formTitle": "LinkedIn Post Generator",
        "formDescription": "Enter a topic. AI drafts and reviews a LinkedIn post, then emails it to you for approval.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "placeholder": "e.g. Remote work",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "b7c1e9a2-4d3f-4a51-9e0b-1c2d3e4f5a61"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a LinkedIn post about: {{ $json.Topic }}\n\nRules:\n- Hook in line one (a bold claim, surprising stat or sharp question)\n- 120-150 words total\n- Short paragraphs, 1-2 sentences each\n- Exactly one call to action near the end\n- Maximum 3 relevant hashtags on the last line\n\nReturn the post only. No preamble, no quotes, no headings.",
        "options": {
          "systemMessage": "You are an experienced LinkedIn ghostwriter. You write clear, human, first-person posts for professionals. No emojis overload, no clichés like 'In today's fast-paced world'."
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Writer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [240, 0]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.8
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Writer Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [240, 220]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Review the LinkedIn post below.\n\n1. Privately score it out of 10 on each standard:\n   - Hook: does line one stop the scroll?\n   - Clarity: one idea, plain words, short sentences, 120-150 words?\n   - CTA: exactly one clear call to action?\n   - Format: max 3 hashtags, no filler, no clichés?\n2. Rewrite the weakest part (and fix any rule the post breaks). Keep everything that already works.\n3. Return the FINAL improved post only. Do not include scores, notes, or explanations.\n\nPOST:\n{{ $json.output }}",
        "options": {
          "systemMessage": "You are a strict LinkedIn editor. You return only the finished, ready-to-publish post text."
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Reviewer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [560, 0]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Reviewer Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [560, 220]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@gmail.com",
        "subject": "=Approve LinkedIn post: {{ $('On form submission').item.json.Topic }}",
        "message": "=<p><b>Topic:</b> {{ $('On form submission').item.json.Topic }}</p><hr><p>{{ $json.output.replace(/\\n/g, '<br>') }}</p><hr><p>Approve to save this post to Google Sheets. Reject to discard it.</p>",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 1,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Send for Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [880, 0],
      "webhookId": "c8d2fa13-5e4a-4b62-8f1c-2d3e4f5a6b72"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d9e3ab24-6f5b-4c73-9a2d-3e4f5a6b7c83",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.format('yyyy-MM-dd') }}",
            "Topic": "={{ $('On form submission').item.json.Topic }}",
            "Final Post": "={{ $('Reviewer Agent').item.json.output }}",
            "Status": "Approved"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Date", "displayName": "Date", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Topic", "displayName": "Topic", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Final Post", "displayName": "Final Post", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Status", "displayName": "Status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Save Approved Post",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1340, -100]
    },
    {
      "parameters": {},
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Rejected - Nothing Saved",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 100]
    }
  ],
  "connections": {
    "On form submission": {
      "main": [[{ "node": "Writer Agent", "type": "main", "index": 0 }]]
    },
    "Writer Chat Model": {
      "ai_languageModel": [[{ "node": "Writer Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Writer Agent": {
      "main": [[{ "node": "Reviewer Agent", "type": "main", "index": 0 }]]
    },
    "Reviewer Chat Model": {
      "ai_languageModel": [[{ "node": "Reviewer Agent", "type": "ai_languageModel", "index": 0 }]]
    },
