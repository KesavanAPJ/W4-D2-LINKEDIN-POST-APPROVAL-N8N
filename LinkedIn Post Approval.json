    },
    "Send for Approval": {
      "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]]
    },
    "Approved?": {
      "main": [
        [{ "node": "Save Approved Post", "type": "main", "index": 0 }],
        [{ "node": "Rejected - Nothing Saved", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
